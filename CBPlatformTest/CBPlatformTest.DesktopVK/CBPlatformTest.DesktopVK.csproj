<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../CBPlatformTest.Core/Content/Icon.ico</ApplicationIcon>
    <AssemblyName>CBPlatformTest</AssemblyName>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
    <!-- Set to true by the workflows after the Build-Content action has already built the content. -->
    <WorkflowMode>false</WorkflowMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CBPlatformTest.Core\CBPlatformTest.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="..\Content\Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6-preview.*" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.6-preview.*" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="3.8.6-preview.*" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="3.8.6-preview.*" />
  </ItemGroup>
  <Import Project="..\Content\BuildContent.targets" />
</Project>
